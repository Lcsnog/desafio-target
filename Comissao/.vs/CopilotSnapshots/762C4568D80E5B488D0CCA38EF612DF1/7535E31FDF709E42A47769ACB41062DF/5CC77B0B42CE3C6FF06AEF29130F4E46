using System.Text.Json;
using VendasJson.Models;
using VendasJson.Services;

namespace Program
{
    class Program
    {
        static void Main(string[] args)
        {
            ComissaoService comissaoService = new ComissaoService();

            string jsonString = File.ReadAllText("vendas.json");

            DadosVendas dados = JsonSerializer.Deserialize<DadosVendas>(jsonString);

            foreach (var venda in dados.Vendas)
            {
                Console.WriteLine($"Vendedor: {venda.Vendedor}");
                Console.WriteLine($"Valor da venda: R$ {venda.Valor:F2}");

                decimal comissao = comissaoService.CalcularComissao(venda.Valor);

                Console.WriteLine($"Comissão: R$ {comissao:F2}");
                Console.WriteLine();
            }
        }
    }
}